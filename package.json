{
	"name": "@cropwatchdevelopment/qr-scanner",
	"version": "0.1.0",
	"description": "CropWatch's QR code reader: finds and decodes QR codes in camera frames and photos. Written from ISO/IEC 18004, no third-party decoder.",
	"keywords": [
		"qr",
		"qr-code",
		"qrcode",
		"decoder",
		"scanner",
		"reader",
		"barcode",
		"camera",
		"iso-18004"
	],
	"license": "MIT",
	"author": "CropWatch LLC",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CropWatchDevelopment/cw-qr-scanner.git"
	},
	"homepage": "https://github.com/CropWatchDevelopment/cw-qr-scanner#readme",
	"bugs": {
		"url": "https://github.com/CropWatchDevelopment/cw-qr-scanner/issues"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"prepublishOnly": "pnpm run check && pnpm run test && pnpm run build"
	},
	"packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/qrcode": "^1.5.6",
		"prettier": "^3.9.10",
		"qrcode": "1.5.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
