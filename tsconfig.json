{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"types": ["node"],
		"outDir": "dist"
	},
	"include": ["src", "test"]
}
